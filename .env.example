# Copy to .env and fill in. .env is gitignored; this example is not.
# Every provider whose key is missing is skipped silently, so a single
# configured provider is enough to run. `python3 -m llmaestro --check`
# reports what is seen and what is missing.

# https://cloud.cerebras.ai - free tier, fast, context-capped
CEREBRAS_API_KEY=

# https://console.groq.com - free tier, high volume on small models
GROQ_API_KEY=

# https://openrouter.ai - free tier, many models behind one key
OPENROUTER_API_KEY=

# Local inference. Only needed when Ollama does not listen on the default host.
# OLLAMA_HOST=http://localhost:11434

# Where the ledger and dedup database live. Defaults to ~/.llmaestro
# LLMAESTRO_HOME=
